      "scenario": "lost-response",
      "side_effects": 2,
      "expected_verdict": "inconclusive",
      "note": "Both commits reuse the same side_effect_id, so the ledger can not be trusted.",
      "events": [
        {"seq": 1, "kind": "request_sent", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"path": "/payments", "idempotency_key_present": false, "idempotency_key_fingerprint": null}},
        {"seq": 2, "kind": "request_received", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"has_idempotency_key": false}},
        {"seq": 3, "kind": "side_effect_committed", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"side_effect_id": "effect-1"}},
        {"seq": 4, "kind": "response_dropped", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"status_code": 201}},
        {"seq": 5, "kind": "request_sent", "attempt_id": "attempt-2", "operation_id": "op-1", "data": {"path": "/payments", "idempotency_key_present": false, "idempotency_key_fingerprint": null}},
        {"seq": 6, "kind": "request_received", "attempt_id": "attempt-2", "operation_id": "op-1", "data": {"has_idempotency_key": false}},
        {"seq": 7, "kind": "side_effect_committed", "attempt_id": "attempt-2", "operation_id": "op-1", "data": {"side_effect_id": "effect-1"}},
        {"seq": 8, "kind": "response_returned", "attempt_id": "attempt-2", "operation_id": "op-1", "data": {"status_code": 201}},
        {"seq": 9, "kind": "scenario_end", "attempt_id": null, "operation_id": null, "data": {"outcome": "client_completed"}}
      ]
    },
    {
