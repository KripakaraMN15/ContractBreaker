{
  "suite": "evidence-integrity",
  "dataset": "contractbreaker-integrity",
  "dataset_version": "1.0",
  "description": "Stored traces run through the production verifiers. Corrupt or contradictory evidence must never be confirmed; the positive control must still confirm.",
