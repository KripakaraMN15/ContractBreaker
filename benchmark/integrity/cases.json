    {
      "id": "integrity-timeout-without-harness-provenance",
      "scenario": "client-timeout",
      "side_effects": 1,
      "invariant": "abort-on-timeout",
      "expected_verdict": "inconclusive",
      "note": "The timeout event claims the real requests timeout was enforced, which this harness can not verify.",
      "events": [
        {"seq": 1, "kind": "request_sent", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"path": "/payments", "declared_timeout_seconds": 5.0, "declared_timeout_source": "derived_from_extraction", "idempotency_key_present": false, "idempotency_key_fingerprint": null}},
        {"seq": 2, "kind": "request_received", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"has_idempotency_key": false}},
        {"seq": 3, "kind": "client_timeout_observed", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"declared_timeout_seconds": 5.0, "declared_timeout_source": "derived_from_extraction", "enforced_by": "requests", "timeout_transport": "in_process_wsgi", "origin": "harness_timeout_fault", "real_requests_timeout_enforced": false, "timeout_mode": "client_first_then_commit"}},
        {"seq": 4, "kind": "side_effect_committed", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"side_effect_id": "effect-1"}},
        {"seq": 5, "kind": "server_processing_completed", "attempt_id": "attempt-1", "operation_id": "op-1", "data": {"outcome": "committed", "origin": "test_service"}},
        {"seq": 6, "kind": "scenario_end", "attempt_id": null, "operation_id": null, "data": {"outcome": "client_gave_up"}}
      ]
    },
